<?xml version="1.0" encoding="utf-8"?>
<!--
  Package.appxmanifest
  ====================
  MSIX package manifest — used ONLY when building the Microsoft Store package
  (dotnet/msbuild with -p:BuildMsix=true; see docs/STORE-PUBLISHING.md).
  Normal development builds run UNPACKAGED and ignore this file entirely
  (WindowsPackageType=None in the csproj).

  ┌─────────────────────────────────────────────────────────────────────────┐
  │ BEFORE SUBMITTING: replace the three PLACEHOLDER values below with the  │
  │ real ones from Partner Center. After reserving the app name, they are   │
  │ listed under  Product management → Product identity :                   │
  │                                                                         │
  │   Identity/Name        ← "Package/Identity/Name"                        │
  │   Identity/Publisher   ← "Package/Identity/Publisher" (CN=GUID form)    │
  │   PublisherDisplayName ← "Package/Properties/PublisherDisplayName"      │
  │                                                                         │
  │ The Store REJECTS uploads whose identity does not match the reserved    │
  │ name, so these cannot be invented locally.                              │
  └─────────────────────────────────────────────────────────────────────────┘

  Signing note: the package is built UNSIGNED (AppxPackageSigningEnabled is
  false) — the Store signs submissions itself with Microsoft's certificate.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="PLACEHOLDER.FROM.PARTNER.CENTER"
    Publisher="CN=PLACEHOLDER-FROM-PARTNER-CENTER"
    Version="1.1.0.0" />

  <Properties>
    <DisplayName>ESL EPUB Reader</DisplayName>
    <PublisherDisplayName>PLACEHOLDER FROM PARTNER CENTER</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <!-- Same floor as the unpackaged app: Windows 10 1809. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <!-- x-generate: the build derives the resource language list. -->
    <Resource Language="x-generate" />
  </Resources>

  <Applications>
    <!-- $targetnametoken$/$targetentrypoint$ are expanded by the single-
         project MSIX tooling to the actual exe name and entry point. -->
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="$targetentrypoint$">
      <uap:VisualElements
        DisplayName="ESL EPUB Reader"
        Description="An ePub reader for English learners: select any word or sentence for instant dictionary lookups, translation into 130+ languages, and text-to-speech."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square71x71Logo="Assets\Square71x71Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
        <uap:SplashScreen Image="Assets\SplashScreen.png" />
      </uap:VisualElements>

      <Extensions>
        <!-- Register as an .epub handler so double-clicking a book in
             Explorer can open it with this app. -->
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="epub">
            <uap:SupportedFileTypes>
              <uap:FileType>.epub</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- runFullTrust: standard for packaged Win32/WinUI 3 desktop apps. -->
    <rescap:Capability Name="runFullTrust" />
    <!-- Online dictionary/translation lookups. -->
    <Capability Name="internetClient" />
  </Capabilities>
</Package>
