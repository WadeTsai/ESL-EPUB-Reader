<?xml version="1.0" encoding="utf-8"?>
<!--
  app.manifest
  ============
  Classic Win32 application manifest. WinUI 3 apps still need this for two
  things:

  1. DPI awareness — "PerMonitorV2" makes text and layout stay crisp when the
     window moves between monitors with different scaling factors (very common
     on Windows 11 laptops with external screens).

  2. OS compatibility declaration — tells Windows we support Windows 10/11 so
     the app is not run in a compatibility shim.
-->
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="EslEpubReader.app"/>

  <compatibility xmlns="urn:schemas-microsoft-com:compatibility.v1">
    <application>
      <!-- Windows 10 and Windows 11 share this supportedOS GUID. -->
      <supportedOS Id="{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}" />
    </application>
  </compatibility>

  <application xmlns="urn:schemas-microsoft-com:asm.v3">
    <windowsSettings>
      <!-- Per-Monitor-V2 DPI awareness: the correct mode for WinUI 3. -->
      <dpiAwareness xmlns="http://schemas.microsoft.com/SMI/2016/WindowsSettings">PerMonitorV2</dpiAwareness>
    </windowsSettings>
  </application>
</assembly>
