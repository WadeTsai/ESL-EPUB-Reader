<!--
  App.xaml
  ========
  Application-level XAML. Its single important job here is to merge the
  WinUI 3 control resources (XamlControlsResources) into the app's resource
  dictionary — WITHOUT this, no WinUI control (Button, ListView, WebView2...)
  can find its default style and the app crashes at startup.
-->
<Application
    x:Class="EslEpubReader.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- Default styles/templates for every WinUI 3 control. -->
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- App-wide constants can be added here later (brushes, sizes…). -->
        </ResourceDictionary>
    </Application.Resources>
</Application>
