<!--
  MainWindow.xaml
  ===============
  The single window of the app, styled like a modern Windows 11 application:

    * a MICA backdrop (set in code-behind) shines through the whole window —
      the root grid is deliberately TRANSPARENT so the material is visible;
    * the content extends into the TITLE BAR (custom AppTitleBar element);
    * the three panes float as rounded "CARDS" on the backdrop, separated by
      draggable gaps (the ColumnSplitter controls);
    * a day/night button in the toolbar switches the whole tree between
      light and dark via RootGrid.RequestedTheme — every color below is a
      {ThemeResource}, so both themes come for free.

  Layout (a 4-row outer grid):

  ┌──────────────────────────────────────────────────────────────┐
  │ TITLE BAR: app icon + name (drag region, caption buttons)    │  row 0
  ├──────────────────────────────────────────────────────────────┤
  │ TOOLBAR: open · chapters · zoom · fonts · read-aloud · theme │  row 1
  ├───────────────┬───────────────────────────┬──────────────────┤
  │ CHAPTER CARD  │  READER CARD (WebView2)   │ DICTIONARY CARD  │  row 2
  ├───────────────┴───────────────────────────┴──────────────────┤
  │ STATUS BAR                                                   │  row 3
  └──────────────────────────────────────────────────────────────┘

  Data binding notes: list content uses {x:Bind} in DataTemplates with
  x:DataType (compile-time checked; bool binds straight to Visibility);
  everything else is updated from code-behind via x:Name references.
-->
<Window
    x:Class="EslEpubReader.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:EslEpubReader.Models"
    xmlns:controls="using:EslEpubReader.Controls">

    <!-- Root container. NO background brush here: the Mica/Acrylic backdrop
         installed in code-behind must show through. RequestedTheme is set on
         this element to flip the whole tree between light and dark. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>     <!-- custom title bar -->
            <RowDefinition Height="Auto"/>   <!-- toolbar -->
            <RowDefinition Height="*"/>      <!-- main content -->
            <RowDefinition Height="Auto"/>   <!-- status bar -->
        </Grid.RowDefinitions>

        <!-- ═══════════════════ TITLE BAR (row 0) ══════════════════════════
             Registered with SetTitleBar() in code-behind, which makes this
             whole strip the window-drag region; Windows overlays its own
             minimize/maximize/close buttons at the top-right corner. -->
        <Grid x:Name="AppTitleBar" Grid.Row="0" Padding="16,0,0,0">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <!-- E736 = "ReadingMode" glyph — the app's identity mark. -->
                <FontIcon Glyph="&#xE736;" FontSize="14"
                          Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                <TextBlock Text="ESL ePub Reader"
                           Style="{ThemeResource CaptionTextBlockStyle}"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════ TOOLBAR (row 1) ════════════════════════════
             Two-column grid: everyday reading controls on the left, the
             appearance (theme) control pinned to the right edge. -->
        <Grid Grid.Row="1" Padding="12,4,12,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">

                <!-- Primary action gets the ACCENT style so the eye lands on
                     it first — everything else stays quiet. -->
                <Button x:Name="OpenBookButton" Click="OpenBookButton_Click"
                        Style="{ThemeResource AccentButtonStyle}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE8E5;" FontSize="16"/>  <!-- "OpenFile" -->
                        <TextBlock Text="Open ePub"/>
                    </StackPanel>
                </Button>

                <AppBarSeparator/>

                <!-- Chapter navigation: enabled only while a book is open. -->
                <Button x:Name="PrevChapterButton" Click="PrevChapterButton_Click"
                        IsEnabled="False" ToolTipService.ToolTip="Previous chapter">
                    <FontIcon Glyph="&#xE76B;" FontSize="14"/>      <!-- chevron left -->
                </Button>
                <Button x:Name="NextChapterButton" Click="NextChapterButton_Click"
                        IsEnabled="False" ToolTipService.ToolTip="Next chapter">
                    <FontIcon Glyph="&#xE76C;" FontSize="14"/>      <!-- chevron right -->
                </Button>

                <AppBarSeparator/>

                <!-- Text size: important accessibility feature for ESL readers
                     who often prefer larger type while decoding new words. -->
                <Button x:Name="ZoomOutButton" Click="ZoomOutButton_Click"
                        ToolTipService.ToolTip="Smaller text">
                    <FontIcon Glyph="&#xE738;" FontSize="14"/>      <!-- minus -->
                </Button>
                <TextBlock x:Name="ZoomLabel" Text="100%" VerticalAlignment="Center"
                           MinWidth="44" TextAlignment="Center"/>
                <Button x:Name="ZoomInButton" Click="ZoomInButton_Click"
                        ToolTipService.ToolTip="Larger text">
                    <FontIcon Glyph="&#xE710;" FontSize="14"/>      <!-- plus -->
                </Button>

                <AppBarSeparator/>

                <!-- Font family for the chapter text. "Book default" (index 0)
                     keeps the publisher's own fonts; any other choice overrides
                     them via injected CSS (see ApplyReaderStyleAsync). The Tag
                     holds the CSS font-family value; an empty Tag = no override.
                     All listed fonts ship with Windows 11. -->
                <ComboBox x:Name="FontFamilyCombo" MinWidth="150" SelectedIndex="0"
                          SelectionChanged="ReaderStyleCombo_SelectionChanged"
                          ToolTipService.ToolTip="Reading font">
                    <ComboBoxItem Content="Book default font" Tag=""/>
                    <ComboBoxItem Content="Segoe UI" Tag="'Segoe UI', sans-serif"/>
                    <ComboBoxItem Content="Verdana" Tag="Verdana, sans-serif"/>
                    <ComboBoxItem Content="Arial" Tag="Arial, sans-serif"/>
                    <ComboBoxItem Content="Georgia" Tag="Georgia, serif"/>
                    <ComboBoxItem Content="Times New Roman" Tag="'Times New Roman', serif"/>
                    <ComboBoxItem Content="Cambria" Tag="Cambria, serif"/>
                    <ComboBoxItem Content="Comic Sans MS" Tag="'Comic Sans MS', cursive"/>
                    <ComboBoxItem Content="Consolas" Tag="Consolas, monospace"/>
                </ComboBox>

                <!-- Line spacing (CSS line-height). Extra space between lines is
                     a classic readability aid for language learners. Tag holds
                     the CSS line-height value; empty Tag = book default. -->
                <ComboBox x:Name="LineSpacingCombo" MinWidth="130" SelectedIndex="0"
                          SelectionChanged="ReaderStyleCombo_SelectionChanged"
                          ToolTipService.ToolTip="Line spacing">
                    <ComboBoxItem Content="Default spacing" Tag=""/>
                    <ComboBoxItem Content="Spacing 1.4" Tag="1.4"/>
                    <ComboBoxItem Content="Spacing 1.6" Tag="1.6"/>
                    <ComboBoxItem Content="Spacing 1.8" Tag="1.8"/>
                    <ComboBoxItem Content="Spacing 2.0" Tag="2.0"/>
                    <ComboBoxItem Content="Spacing 2.5" Tag="2.5"/>
                </ComboBox>

                <!-- Single-page / dual-page layout switch. OFF (default) =
                     one continuous vertically-scrolling page; ON = the
                     chapter is laid out as side-by-side page columns that
                     flip HORIZONTALLY with the mouse wheel — like an open
                     paper book. Realized in ApplyReaderStyleAsync with CSS
                     multi-columns. E736 = "ReadingMode" (open book) glyph. -->
                <ToggleButton x:Name="DualPageToggle"
                              Checked="DualPageToggle_Toggled"
                              Unchecked="DualPageToggle_Toggled"
                              ToolTipService.ToolTip="Dual-page view (like an open book)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon Glyph="&#xE736;" FontSize="14"/>
                        <TextBlock Text="Dual page"/>
                    </StackPanel>
                </ToggleButton>

                <AppBarSeparator/>

                <!-- "Read it aloud" on/off switch. While ON (the default), every
                     dictionary lookup also speaks the selected text through the
                     Windows built-in text-to-speech voice. The glyph flips
                     between speaker (on) and muted (off) in code-behind. -->
                <ToggleButton x:Name="ReadAloudToggle" IsChecked="True"
                              Checked="ReadAloudToggle_Toggled"
                              Unchecked="ReadAloudToggle_Toggled"
                              ToolTipService.ToolTip="Read selected text aloud (text-to-speech)">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <FontIcon x:Name="ReadAloudIcon" Glyph="&#xE767;" FontSize="14"/>
                        <TextBlock Text="Read aloud"/>
                    </StackPanel>
                </ToggleButton>

                <AppBarSeparator/>

                <!-- Current book title + author, filled in after opening. -->
                <TextBlock x:Name="BookTitleText" VerticalAlignment="Center"
                           Style="{ThemeResource BodyStrongTextBlockStyle}"
                           TextTrimming="CharacterEllipsis"
                           Text="Open an .epub file to start reading"/>
            </StackPanel>

            <!-- Right-pinned group: panel visibility toggles + theme switch. -->
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">

                <!-- Hide/unhide the CHAPTERS panel (left card). Checked =
                     visible (the default). Hiding the side panels gives the
                     book the full window width for distraction-free reading.
                     E90C = "DockLeft" glyph (a left-side panel). -->
                <ToggleButton x:Name="ChapterPaneToggle" IsChecked="True"
                              Checked="ChapterPaneToggle_Toggled"
                              Unchecked="ChapterPaneToggle_Toggled"
                              ToolTipService.ToolTip="Show / hide the chapter list">
                    <FontIcon Glyph="&#xE90C;" FontSize="14"/>
                </ToggleButton>

                <!-- Hide/unhide the DICTIONARY panel (right card).
                     E90D = "DockRight" glyph (a right-side panel). -->
                <ToggleButton x:Name="DictPaneToggle" IsChecked="True"
                              Checked="DictPaneToggle_Toggled"
                              Unchecked="DictPaneToggle_Toggled"
                              ToolTipService.ToolTip="Show / hide the dictionary panel">
                    <FontIcon Glyph="&#xE90D;" FontSize="14"/>
                </ToggleButton>

                <AppBarSeparator/>

                <!-- Day/night switch. Shows the icon of the theme you would
                     SWITCH TO (moon in light mode, sun in dark mode). The two
                     FontIcons are toggled via Visibility from code-behind
                     (avoids composing glyph strings in C#). -->
                <Button x:Name="ThemeToggleButton"
                        Click="ThemeToggleButton_Click"
                        ToolTipService.ToolTip="Switch between day and night theme">
                    <Grid>
                        <FontIcon x:Name="MoonIcon" Glyph="&#xE708;" FontSize="14"/>  <!-- "QuietHours" moon -->
                        <FontIcon x:Name="SunIcon"  Glyph="&#xE706;" FontSize="14"
                                  Visibility="Collapsed"/>                            <!-- "Brightness" sun -->
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>

        <!-- ═══════════════════ CONTENT (row 2) ════════════════════════════
             Five columns: three pane CARDS plus two draggable splitters that
             live in the visual GAPS between the cards. The two side panes
             have FIXED pixel widths (what the splitters change), each with
             Min/Max limits; the middle reader column is star-sized and
             absorbs whatever space the sides release. -->
        <Grid Grid.Row="2" Padding="12,0,12,0">
            <Grid.ColumnDefinitions>
                <!-- The side columns and their splitters carry x:Names so the
                     toolbar hide/unhide toggles can collapse them from code
                     (a hidden pane needs BOTH Visibility=Collapsed on the
                     card AND a zero column width — see SetPaneVisibility). -->
                <ColumnDefinition x:Name="ChapterColumn"
                                  Width="240" MinWidth="140" MaxWidth="480"/>  <!-- 0: chapter card -->
                <ColumnDefinition Width="Auto"/>                               <!-- 1: splitter -->
                <ColumnDefinition Width="*"   MinWidth="240"/>                 <!-- 2: reader card -->
                <ColumnDefinition Width="Auto"/>                               <!-- 3: splitter -->
                <ColumnDefinition x:Name="DictColumn"
                                  Width="380" MinWidth="240" MaxWidth="700"/>  <!-- 4: dictionary card -->
            </Grid.ColumnDefinitions>

            <!-- ── Chapter list card ────────────────────────────────────── -->
            <Border x:Name="ChapterPane" Grid.Column="0" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Chapters" Padding="16,12,16,8"
                               Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                    <!-- Each item is an EpubChapter; ListView shows its
                         ToString() (= the title). SelectionChanged navigates. -->
                    <ListView x:Name="ChapterList" Grid.Row="1" Padding="0,0,0,8"
                              SelectionChanged="ChapterList_SelectionChanged"/>
                </Grid>
            </Border>

            <!-- ── Splitter: chapter card ↔ reader card ────────────────────
                 An invisible 10px grab strip filling the gap between the
                 cards; the resize cursor is the affordance. Drags the
                 CHAPTER column (to its LEFT — the default direction). -->
            <controls:ColumnSplitter x:Name="ChapterSplitter" Grid.Column="1" TargetColumn="0"
                                     Width="10" Background="Transparent"/>

            <!-- ── Reader card ──────────────────────────────────────────── -->
            <!-- WebView2 renders the chapter XHTML with the publisher's own
                 CSS and images. The injected script (see code-behind) posts
                 every text selection back to C#. NOTE: WebView2 is a native
                 HWND, so the Border's rounded corners do not clip the web
                 surface itself — a 1px inset makes the seam invisible. -->
            <Border Grid.Column="2" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <WebView2 x:Name="ReaderWebView" Margin="1"/>
            </Border>

            <!-- ── Splitter: reader card ↔ dictionary card ─────────────────
                 Drags the DICTIONARY column, which lies to its RIGHT —
                 ResizeRightColumn mirrors the math (drag right = shrink). -->
            <controls:ColumnSplitter x:Name="DictSplitter" Grid.Column="3" TargetColumn="4"
                                     ResizeRightColumn="True"
                                     Width="10" Background="Transparent"/>

            <!-- ── Dictionary card (THE core ESL feature) ───────────────── -->
            <Border x:Name="DictPane" Grid.Column="4" CornerRadius="8" BorderThickness="1"
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>   <!-- looked-up term header -->
                        <RowDefinition Height="*"/>      <!-- scrolling results -->
                    </Grid.RowDefinitions>

                    <!-- Header: the selected word/phrase + IPA pronunciation. -->
                    <StackPanel Grid.Row="0" Padding="16,12,16,8" Spacing="2">

                        <!-- Caption row with the TRANSLATION LANGUAGE picker.
                             The picker drives BOTH Google sections below
                             (translation + dictionary); the choice is saved
                             to settings.json and restored at every launch.
                             ItemsSource (the full Google Translate language
                             list) is assigned in code from LanguageCatalog. -->
                        <Grid ColumnSpacing="8" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="DICTIONARY" FontSize="11" CharacterSpacing="80"
                                       VerticalAlignment="Center"
                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"/>
                            <ComboBox x:Name="LanguageCombo" Grid.Column="1"
                                      MinWidth="170" MaxWidth="230" FontSize="12"
                                      DisplayMemberPath="DisplayName"
                                      SelectionChanged="LanguageCombo_SelectionChanged"
                                      ToolTipService.ToolTip="Translation language (Google Translate &amp; Google Dictionary)"/>
                        </Grid>

                        <!-- The looked-up term with a SPEAK button at its end:
                             pressing it reads the text aloud on demand — even
                             when the automatic "Read aloud" toggle is OFF
                             (replay a tricky word as many times as needed).
                             A Grid (not a horizontal StackPanel) lets the term
                             wrap over several lines while the button stays
                             pinned to the top-right. -->
                        <Grid ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="SelectedTermText" Grid.Column="0"
                                       Text="Select a word or phrase in the book"
                                       Style="{ThemeResource TitleTextBlockStyle}"
                                       TextWrapping="Wrap"/>
                            <!-- Disabled until the first lookup gives us
                                 something to pronounce (see code-behind). -->
                            <Button x:Name="SpeakTermButton" Grid.Column="1"
                                    Click="SpeakTermButton_Click"
                                    IsEnabled="False" VerticalAlignment="Top"
                                    Padding="8,6"
                                    ToolTipService.ToolTip="Read this text aloud">
                                <FontIcon Glyph="&#xE767;" FontSize="14"/>  <!-- speaker -->
                            </Button>
                        </Grid>

                        <TextBlock x:Name="PhoneticText" Text="" FontStyle="Italic"
                                   Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                    </StackPanel>

                    <!-- Results: all three sources stacked in one scroll view.
                         Each section header = small accent bar + title, a
                         light-weight modern alternative to heavy borders. -->
                    <ScrollViewer Grid.Row="1" Padding="16,0,16,8">
                        <StackPanel Spacing="8">

                            <!-- ▸ Google Translate section — shown FIRST: one
                                 fluent rendering of the whole selection (works
                                 for complete sentences too). The header text
                                 is updated from code with the chosen language:
                                 "Google Translate (繁體中文)". -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Border Width="3" Height="14" CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="TranslateSectionHeader"
                                           Text="Google Translate (繁體中文)"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="TranslationStatusText" Text=""
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <!-- IsTextSelectionEnabled lets the learner copy the
                                 translation into their own notes. -->
                            <TextBlock x:Name="TranslationText" Text=""
                                       TextWrapping="Wrap" FontSize="16"
                                       IsTextSelectionEnabled="True"/>

                            <!-- ▸ English → English section -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Border Width="3" Height="14" CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="English – English"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="EnglishStatusText" Text=""
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="EnglishSensesList">
                                <ItemsControl.ItemTemplate>
                                    <!-- x:DataType enables compile-time-checked
                                         x:Bind to EnglishSense properties. -->
                                    <DataTemplate x:DataType="models:EnglishSense">
                                        <StackPanel Margin="0,0,0,10" Spacing="2">
                                            <!-- part-of-speech badge, e.g. "noun" -->
                                            <TextBlock Text="{x:Bind PartOfSpeech}" FontSize="12"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <TextBlock Text="{x:Bind Definition}" TextWrapping="Wrap"/>
                                            <!-- example sentence: hidden when absent
                                                 (bool HasExample -> Visibility). -->
                                            <TextBlock Text="{x:Bind Example}" TextWrapping="Wrap"
                                                       FontStyle="Italic" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasExample}"/>
                                            <TextBlock Text="{x:Bind Synonyms}" TextWrapping="Wrap"
                                                       FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                                       Visibility="{x:Bind HasSynonyms}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- ▸ Google Dictionary section: ranked translations
                                 of the selected word in the chosen language,
                                 grouped by part of speech, with English
                                 back-translations for sense-checking. Header
                                 text updated from code with the language. -->
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,8,0,0">
                                <Border Width="3" Height="14" CornerRadius="1.5"
                                        Background="{ThemeResource AccentFillColorDefaultBrush}"/>
                                <TextBlock x:Name="DictSectionHeader"
                                           Text="Google Dictionary (繁體中文)"
                                           Style="{ThemeResource BodyStrongTextBlockStyle}"/>
                            </StackPanel>
                            <TextBlock x:Name="ChineseStatusText" Text=""
                                       TextWrapping="Wrap"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Visibility="Collapsed"/>
                            <ItemsControl x:Name="ChineseEntriesList" Margin="0,0,0,12">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:GoogleDictionaryEntry">
                                        <StackPanel Margin="0,0,0,10" Spacing="2">
                                            <!-- part-of-speech badge ("noun") — same
                                                 look as the English–English section -->
                                            <TextBlock Text="{x:Bind PartOfSpeech}" FontSize="12"
                                                       FontStyle="Italic"
                                                       Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                            <!-- the Traditional Chinese term, large
                                                 for readability: 傳統 -->
                                            <TextBlock Text="{x:Bind Term}" FontSize="20"/>
                                            <!-- English back-translations so the
                                                 learner can confirm the right sense
                                                 was found; hidden when empty -->
                                            <TextBlock Text="{x:Bind BackTranslations}"
                                                       TextWrapping="Wrap" FontSize="13"
                                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                       Visibility="{x:Bind HasBackTranslations}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- ═══════════════════ STATUS BAR (row 3) ═════════════════════════
             Transparent strip directly on the backdrop — no border needed,
             the cards above provide the visual separation. -->
        <Grid Grid.Row="3" Padding="16,8,16,10">
            <TextBlock x:Name="StatusText" FontSize="12"
                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                       Text="Ready."/>
        </Grid>
    </Grid>
</Window>
