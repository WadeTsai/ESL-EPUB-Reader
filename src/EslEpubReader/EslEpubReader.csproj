<!--
  EslEpubReader.csproj
  =====================
  Project file for the ESL ePub Reader — a WinUI 3 desktop application for
  English-as-a-Second-Language readers on Windows 11.

  Key decisions encoded in this file:

  * TargetFramework "net10.0-windows10.0.19041.0"
      - .NET 10 is required because the project uses C# 14 language features.
      - The "windows10.0.19041.0" suffix gives us access to the Windows SDK
        projections (WinRT APIs such as FileOpenPicker) at compile time.

  * LangVersion 14.0
      - Explicitly pins the C# language version to 14 as requested,
        instead of relying on the SDK default.

  * UseWinUI true + Microsoft.WindowsAppSDK package
      - This is what turns the project into a WinUI 3 (Windows App SDK) app.
        The XAML compiler, WinUI controls (including WebView2), and the
        Windows App SDK runtime all come from this package.

  * WindowsPackageType None + WindowsAppSDKSelfContained true
      - The app runs UNPACKAGED (no MSIX install step needed) and carries the
        Windows App SDK runtime with it, so a plain `dotnet build` followed by
        running the produced .exe "just works" on a clean Windows 11 machine.
-->
<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe = a GUI application (no console window is attached). -->
    <OutputType>WinExe</OutputType>

    <!-- .NET 10 + Windows 10 SDK 19041 projections; app still runs on any
         Windows 10 1809+ machine thanks to TargetPlatformMinVersion. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>

    <!-- Pin the compiler to C# 14 (ships with the .NET 10 SDK). -->
    <LangVersion>14.0</LangVersion>

    <RootNamespace>EslEpubReader</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Embed the app icon (the open-book mark, generated by
         tools/make-icon.ps1) into the .exe itself — this is what Explorer,
         pinned taskbar shortcuts, and Alt+Tab read. The RUNNING window's
         taskbar icon is additionally set at startup via AppWindow.SetIcon
         (see MainWindow's constructor). -->
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <!-- CPU architectures we can build for. x64 is the default on Win11. -->
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Turn on the WinUI 3 XAML compiler and control library. -->
    <UseWinUI>true</UseWinUI>

    <!-- Modern C# hygiene: nullable reference types catch null bugs at
         compile time; implicit usings keep files free of boilerplate. -->
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Run WITHOUT MSIX packaging so `dotnet run` / F5 works directly. -->
    <WindowsPackageType>None</WindowsPackageType>

    <!-- Bundle the Windows App SDK runtime into the output folder so the
         app does not depend on a machine-wide runtime installation. -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- Required by Windows App SDK 1.8 for PublishSingleFile: the MSIX
         tooling generates the resources.pri that gets embedded into the
         single portable .exe. (The app still runs UNPACKAGED — this only
         enables the tooling, it does not produce an MSIX package.) -->
    <EnableMsixTooling>true</EnableMsixTooling>
  </PropertyGroup>

  <ItemGroup>
    <!-- Windows App SDK = WinUI 3 controls, windowing, and the WebView2
         XAML control used to render ePub chapters. -->
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.250916003" />
    <!-- Build-time tooling for the Windows SDK (required by WinUI 3). -->
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.4948" />
  </ItemGroup>

  <ItemGroup>
    <!-- Copy the icon next to the exe so AppWindow.SetIcon can load it at
         runtime (the embedded ApplicationIcon above is not readable as a
         loose file). -->
    <Content Include="Assets\app.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
